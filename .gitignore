# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# Local Superpowers specs and plans. Review in English before publishing.
/docs/superpowers/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
# doc/snippets is a local-only workspace that compiles the documentation
# snippets against the package sources; its lockfile is not part of the repo.
/doc/snippets/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
# Also ignore per-package build output (packages/ix_flutter/build/, created
# by `flutter test`), which the root-anchored pattern above never matches.
build/
/coverage/
