# Publish-only exclusions, relative to this package root. Patterns that name
# paths outside the package (the repository's .github/, doc/images/, ...) would
# never match here, so only what actually exists in the package is listed.

# Libraries should not include pubspec.lock, per
# https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock

# Generated API documentation and build output
**/doc/api/
.dart_tool/
/build/
/coverage/

# Repository tooling: not part of the published library
/tool/
